# Cloudflare Pages reads this from the build output root. Vite copies
# everything in public/ there verbatim, so this file ships as dist/_headers.

# Vite fingerprints everything under /assets, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400

/og-akuru.png
  Cache-Control: public, max-age=86400

/akuru/editor.webp
  Cache-Control: public, max-age=86400

/akuru/icon.svg
  Cache-Control: public, max-age=604800

/brand-icon-512.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon-32.png
  Cache-Control: public, max-age=604800

# The HTML names the current asset hashes, so it must never be held.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/terms/*
  Cache-Control: public, max-age=0, must-revalidate

/privacy/*
  Cache-Control: public, max-age=0, must-revalidate

# Not /akuru/*: Cloudflare joins the Cache-Control of every rule that matches,
# and the images beside this page have their own.
/akuru/
  Cache-Control: public, max-age=0, must-revalidate

/akuru/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # 'unsafe-inline' is required by the critical background style and JSON-LD.
  # It still pins every external origin, which is what actually matters on a
  # page with no user input. Nothing on the site compiles WebAssembly or
  # starts a worker, so neither is allowed. data: in img-src is for the
  # generated grain texture in base.css.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
